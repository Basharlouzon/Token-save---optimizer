{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenso hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenso hook guard-read"
          }
        ],
        "matcher": "Read"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tokenso hook precompact"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "tokenso statusline"
  }
}
